	(text "Vout = Vref(1 + R2/R1)\n3.3 = 1.2(1 + R2/R1)\n1.75 = R2/R1\nTake R1 as 10k\n1.75 * 10,000 = 17.5k ohm\nR2 = 17.5k\n\nClosest is 15k and 2.49k\n3.299V\n\n"
		(exclude_from_sim no)
